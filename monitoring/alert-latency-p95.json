{
  "displayName": "retail-api: p95 latency over 2s",
  "documentation": { "content": "Request latency p95 above 2000 ms for 5 minutes. Likely causes: hot-row contention, connection pool queueing, Cloud SQL CPU, or scale-out lag.", "mimeType": "text/markdown" },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "p95 request latency over 2000 ms for 5 minutes",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"retail-api\"",
        "aggregations": [
          { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_95", "crossSeriesReducer": "REDUCE_MAX" }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2000,
        "duration": "300s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": ["projects/retailgcp/notificationChannels/15476709660617900692"]
}
