{
  "displayName": "retail-api: uptime check failing",
  "documentation": { "content": "The /livez uptime check is failing from more than one location.", "mimeType": "text/markdown" },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "uptime check failing",
      "conditionThreshold": {
        "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.labels.check_id=\"retail-api-livez-tEZz-cx4evU\" AND resource.type=\"uptime_url\"",
        "aggregations": [
          { "alignmentPeriod": "1200s", "perSeriesAligner": "ALIGN_NEXT_OLDER", "crossSeriesReducer": "REDUCE_COUNT_FALSE", "groupByFields": ["resource.label.*"] }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1,
        "duration": "60s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": ["projects/retailgcp/notificationChannels/15476709660617900692"]
}
